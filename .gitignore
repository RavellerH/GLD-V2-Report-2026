# Scratch/working directories for intermediate build output (renders, screenshots,
# extracted assets, debug dumps). Never commit new files here — existing tracked
# files under these paths are left as historical record per project decision.
.tmp/
tmp/

# Packaged zip mirrors of Paket Pertamina/ subfolders — regenerate on demand for
# sending (WA/email) instead of tracking duplicated binaries in git.
Paket Pertamina/*.zip

# Office transient lock files
~$*.doc
~$*.docx
~$*.ppt
~$*.pptx
~$*.xls
~$*.xlsx

# Debug/inspection artifacts from build scripts
*.inspect.ndjson

# OS cruft
Thumbs.db
.DS_Store
__pycache__/

# Secrets
env

# Catatan internal rapat (jangan dipublikasikan)
Paket Meeting TUV SUD 26November2026/00_Catatan_Internal_*

# Komersial & data pribadi (repo publik) — simpan lokal saja
Deliverables/RAB_Material_Instalasi_GLD_RU-VI_Balongan.xlsx
Deliverables/Penawaran_Harga_Material_Instalasi_GLD_RU-VI_Balongan.*
scripts/build_rab_material_ex_balongan.py
Sumber Dokumen/Notulensi_Rapat_RU_VI_Balongan_17November2026.pdf
